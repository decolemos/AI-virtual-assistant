    "deploy": "firebase deploy --only functions,hosting,firestore"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
