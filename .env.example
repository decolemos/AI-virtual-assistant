# Variáveis da versão na Vercel. Cadastre em Vercel > Settings > Environment Variables.
ANTHROPIC_API_KEY=sk-ant-...
EMAILS_PERMITIDOS=seu-email@gmail.com
CIDADE_PADRAO=São Paulo
# JSON inteiro da chave da conta de serviço (Firebase > Configurações > Contas de serviço).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# Configuração do app web (Firebase > Configurações do projeto > Seus apps).
FIREBASE_WEB_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","appId":"..."}
